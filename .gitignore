*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib

# Executables
*.exe
*.out
*.app

# =========================
# Python & PyCharm Artifacts
# =========================
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
.env/

# Jupyter Notebook checkpoints (if you use them)
.ipynb_checkpoints/

